{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() == auth.uid && newData.child('phase').val() == 'lobby' && newData.child('moveCount').val() == 0 && !newData.child('moves').exists() && !newData.child('guestUid').exists() && $code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$/)) || (data.exists() && !newData.exists() && ((data.child('hostUid').val() == auth.uid || data.child('guestUid').val() == auth.uid) || data.child('updatedAt').val() < now - 2592000000)))",
        ".validate": "newData.hasChildren(['hostUid', 'phase', 'variant', 'moveCount'])",
        "hostUid": {
          ".validate": "newData.isString() && (!data.exists() || data.val() == newData.val())"
        },
        "guestUid": {
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid && data.parent().child('hostUid').val() != auth.uid && data.parent().child('phase').val() == 'lobby' && (!data.parent().child('invite').exists() || data.parent().child('invite').val() == auth.uid) && !root.child('users').child(data.parent().child('hostUid').val() + '').child('blocked').child(auth.uid).exists()",
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() == newData.val())"
        },
        "updatedAt": {
          ".write": "auth != null && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid)",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "variant": {
          ".validate": "newData.val().matches(/^(classic|triangle)$/) && (!data.exists() || data.val() == newData.val())"
        },
        "clockMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60 && (!data.exists() || data.val() == newData.val())"
        },
        "styleOne": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "styleTwo": {
          ".validate": "newData.isString() && newData.val().length < 40"
        },
        "phase": {
          ".write": "auth != null && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid)",
          ".validate": "newData.val().matches(/^(lobby|playing|finished|abandoned)$/) && (newData.val() != 'lobby' || !data.exists())"
        },
        "moveCount": {
          ".write": "auth != null && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid)",
          ".validate": "newData.isNumber() && (!data.exists() && newData.val() == 0 || newData.val() == data.val() + 1 && newData.parent().child('moves').child(data.val() + '').exists() || newData.val() == 0 && !newData.parent().child('moves').exists())"
        },
        "connected": {
          "one": {
            ".write": "auth != null && newData.parent().parent().child('hostUid').val() == auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "two": {
            ".write": "auth != null && newData.parent().parent().child('guestUid').val() == auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "leftAt": {
          "one": {
            ".write": "auth != null && newData.parent().parent().child('hostUid').val() == auth.uid",
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "two": {
            ".write": "auth != null && newData.parent().parent().child('guestUid').val() == auth.uid",
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "resigned": {
          ".write": "auth != null && ((data.parent().child('phase').val() == 'playing') && ((newData.val() == 'one' && newData.parent().child('hostUid').val() == auth.uid) || (newData.val() == 'two' && newData.parent().child('guestUid').val() == auth.uid) || (newData.val() == 'two' && newData.parent().child('hostUid').val() == auth.uid && data.parent().child('connected/two').val() == false && data.parent().child('leftAt/two').val() + 90000 <= now) || (newData.val() == 'one' && newData.parent().child('guestUid').val() == auth.uid && data.parent().child('connected/one').val() == false && data.parent().child('leftAt/one').val() + 90000 <= now) || (newData.val() == 'two' && newData.parent().child('hostUid').val() == auth.uid && data.parent().child('toMove').val() == 'two' && data.parent().child('lastMoveAt').val() + 300000 <= now) || (newData.val() == 'one' && newData.parent().child('guestUid').val() == auth.uid && data.parent().child('toMove').val() == 'one' && data.parent().child('lastMoveAt').val() + 300000 <= now))) || (auth != null && !newData.exists() && data.parent().child('phase').val().matches(/^(finished|abandoned)$/) && newData.parent().child('phase').val() == 'playing' && !newData.parent().child('moves').exists() && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid))",
          ".validate": "newData.val().matches(/^(one|two)$/)"
        },
        "offers": {
          ".write": "auth != null && !newData.exists() && (data.parent().child('hostUid').val() == auth.uid || data.parent().child('guestUid').val() == auth.uid) && (newData.parent().child('phase').val() == 'playing')",
          "draw": {
            "one": {
              ".write": "auth != null && newData.parent().parent().parent().child('hostUid').val() == auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "two": {
              ".write": "auth != null && newData.parent().parent().parent().child('guestUid').val() == auth.uid",
              ".validate": "newData.isBoolean()"
            },
            ".write": "auth != null && !newData.exists() && (newData.parent().parent().child('hostUid').val() == auth.uid || newData.parent().parent().child('guestUid').val() == auth.uid) && newData.parent().parent().child('phase').val() == 'playing'"
          },
          "rematch": {
            "one": {
              ".write": "auth != null && newData.parent().parent().parent().child('hostUid').val() == auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "two": {
              ".write": "auth != null && newData.parent().parent().parent().child('guestUid').val() == auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "moves": {
          ".write": "auth != null && !newData.exists() && data.parent().child('phase').val().matches(/^(finished|abandoned)$/) && ((data.parent().child('hostUid').val() == auth.uid && data.parent().child('offers/rematch/two').val() == true) || (data.parent().child('guestUid').val() == auth.uid && data.parent().child('offers/rematch/one').val() == true))",
          "$index": {
            ".write": "auth != null && !data.exists() && newData.parent().parent().child('phase').val() == 'playing' && $index == data.parent().parent().child('moveCount').val() + '' && newData.parent().parent().child('moveCount').val() == data.parent().parent().child('moveCount').val() + 1 && ((newData.child('by').val() == 'one' && newData.parent().parent().child('hostUid').val() == auth.uid) || (newData.child('by').val() == 'two' && newData.parent().parent().child('guestUid').val() == auth.uid)) && (($index == '0' && newData.child('by').val() == 'one' && !newData.child('m').val().beginsWith('S|')) || ($index != '0' && ((newData.child('m').val().beginsWith('S|') && data.parent().child((data.parent().parent().child('moveCount').val() - 1) + '').child('by').val() == newData.child('by').val() && !data.parent().child((data.parent().parent().child('moveCount').val() - 1) + '').child('m').val().beginsWith('S|')) || (!newData.child('m').val().beginsWith('S|') && data.parent().child((data.parent().parent().child('moveCount').val() - 1) + '').child('by').val() != newData.child('by').val()))))",
            ".validate": "newData.hasChildren(['by', 'm'])",
            "by": {
              ".validate": "newData.val().matches(/^(one|two)$/) && (!data.exists() || data.val() == newData.val())"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().matches(/^(P[|][0-9]{1,2}|M[|][0-9]{1,2}[|][0-9]{1,2}|S[|][0-9]{1,2})$/) && (!data.exists() || data.val() == newData.val())"
            }
          }
        },
        "lastMoveAt": {
          ".write": "auth != null && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid)",
          ".validate": "newData.isNumber() && newData.val() == now && (newData.parent().child('moveCount').val() != data.parent().child('moveCount').val() || (newData.parent().child('phase').val() == 'playing' && data.parent().child('phase').val() != 'playing'))"
        },
        "toMove": {
          ".write": "auth != null && (newData.parent().child('hostUid').val() == auth.uid || newData.parent().child('guestUid').val() == auth.uid)",
          ".validate": "newData.val().matches(/^(one|two)$/) && (!data.exists() || newData.val() == data.val() || newData.parent().child('moveCount').val() != data.parent().child('moveCount').val())"
        },
        "$other": {
          ".validate": false
        },
        "ranked": {
          ".validate": "newData.isBoolean() && (!data.exists() || data.val() == newData.val())"
        },
        "invite": {
          ".validate": "false"
        },
        "tournament": {
          ".validate": "false"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "rooms": {
          "$code": {
            ".validate": "newData.isBoolean() && $code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$/)"
          }
        },
        "$other": {
          ".validate": false
        },
        "lastChatAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "blocked": {
          "$other": {
            ".validate": "newData.val() == true && $other != $uid"
          }
        }
      }
    },
    "chats": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() == auth.uid || root.child('rooms').child($code).child('guestUid').val() == auth.uid)",
        ".write": "auth != null && !newData.exists() && (!root.child('rooms').child($code).exists() || (root.child('rooms').child($code).child('hostUid').val() == auth.uid || root.child('rooms').child($code).child('guestUid').val() == auth.uid))",
        "$msg": {
          ".write": "auth != null && ((!data.exists() && (root.child('rooms').child($code).child('hostUid').val() == auth.uid || root.child('rooms').child($code).child('guestUid').val() == auth.uid) && newData.child('uid').val() == auth.uid && newData.parent().parent().parent().child('users').child(auth.uid).child('lastChatAt').val() == now && (!root.child('users').child(auth.uid).child('lastChatAt').exists() || root.child('users').child(auth.uid).child('lastChatAt').val() < now - 1500)) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['uid', 'seat', 'k', 'b', 'at'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "seat": {
            ".validate": "(newData.val() == 'one' && root.child('rooms').child($code).child('hostUid').val() == auth.uid) || (newData.val() == 'two' && root.child('rooms').child($code).child('guestUid').val() == auth.uid)"
          },
          "k": {
            ".validate": "newData.isString() && newData.val().matches(/^(p|e|t)$/)"
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120 && (newData.parent().child('k').val() != 'p' || newData.val().matches(/^(hello|good_luck|your_turn|nice_mill|nice_move|thinking|oops|well_played|good_game|rematch|thanks|bye)$/)) && (newData.parent().child('k').val() != 'e' || newData.val().length <= 4)"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "reports": {
      ".read": "auth != null && auth.token.admin == true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('reporterUid').val() == auth.uid",
        ".validate": "newData.hasChildren(['reporterUid', 'reportedUid', 'room', 'messageId', 'body', 'at'])",
        "reporterUid": {
          ".validate": "newData.isString()"
        },
        "reportedUid": {
          ".validate": "newData.isString() && newData.val() != auth.uid"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$/)"
        },
        "messageId": {
          ".validate": "newData.isString() && newData.val().length < 64"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "at": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "ratings": {
      ".read": "auth != null",
      ".indexOn": [
        "rating"
      ],
      "$uid": {
        ".write": "false"
      }
    },
    "ledger": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "false"
      }
    },
    "settled": {
      ".read": "auth != null",
      "$code": {
        ".write": "false"
      }
    },
    "results": {
      "$code": {
        ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() == auth.uid || root.child('rooms').child($code).child('guestUid').val() == auth.uid)",
        "$seat": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('ranked').val() == true && root.child('rooms').child($code).child('phase').val() == 'finished' && (($seat == 'one' && root.child('rooms').child($code).child('hostUid').val() == auth.uid) || ($seat == 'two' && root.child('rooms').child($code).child('guestUid').val() == auth.uid))",
          ".validate": "newData.isString() && newData.val().matches(/^(one|two|draw)$/) && $seat.matches(/^(one|two)$/)"
        }
      }
    },
    "tournaments": {
      ".read": "auth != null",
      ".indexOn": [
        "status"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('createdBy').val() == auth.uid && !newData.child('entrants').exists()",
        ".validate": "newData.hasChildren(['name', 'size', 'entry', 'createdBy', 'createdAt', 'status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && (!data.exists() || data.val() == newData.val())"
        },
        "size": {
          ".validate": "(newData.val() == 4 || newData.val() == 8 || newData.val() == 16) && (!data.exists() || data.val() == newData.val())"
        },
        "entry": {
          ".validate": "newData.val() == 20 && (!data.exists() || data.val() == newData.val())"
        },
        "createdBy": {
          ".validate": "newData.isString() && (!data.exists() || data.val() == newData.val())"
        },
        "createdAt": {
          ".validate": "newData.val() == now || data.val() == newData.val()"
        },
        "status": {
          ".validate": "newData.val() == 'open' && (!data.exists() || data.val() == newData.val())"
        },
        "entrants": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('tournaments').child($id).child('status').val() == 'open' && (!data.exists() || !newData.exists())",
            ".validate": "newData.isNumber() && newData.val() == now"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}